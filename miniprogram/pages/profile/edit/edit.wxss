.edit-page {
  padding: 24rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6f8fc;
}

.avatar-card,
.form-card {
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.avatar-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.big {
  width: 88rpx;
  height: 88rpx;
  font-size: 36rpx;
  overflow: hidden;
}

.big image {
  width: 100%;
  height: 100%;
}

.change-avatar {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}

.form-row {
  min-height: 88rpx;
  border-top: 2rpx solid #f1f4fa;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-row:first-of-type {
  border-top: 0;
}

.label,
.section-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
}

.field-input {
  flex: 1;
  text-align: right;
  color: #111827;
  font-size: 24rpx;
}

.field-tip {
  padding: 0 0 18rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.5;
}

.picker-value {
  display: flex;
  align-items: center;
  color: #64748b;
  font-size: 24rpx;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.select-tag {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f7f9fd;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.select-tag.active {
  background: #eef2ff;
  color: #4f46e5;
}

.bio-box {
  width: 100%;
  min-height: 180rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f7f9fd;
  box-sizing: border-box;
  color: #111827;
  font-size: 24rpx;
}

.submit-btn {
  height: 84rpx;
  border: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5965ff, #7b4cff);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
  box-shadow: 0 18rpx 36rpx rgba(92, 92, 255, 0.24);
}

.submit-btn::after {
  border: 0;
}
