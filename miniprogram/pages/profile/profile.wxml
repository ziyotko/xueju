<view class="profile-page safe-bottom">
  <view class="profile-hero">
    <view class="profile-actions">
      <view bindtap="goFavorites"><app-icon name="star" size="22" color="#FFFFFF" /></view>
      <view bindtap="goNotifications"><app-icon name="notification" size="22" color="#FFFFFF" /></view>
      <view bindtap="goSettings"><app-icon name="setting" size="22" color="#FFFFFF" /></view>
    </view>
    <image class="profile-cover" mode="aspectFill" src="{{profileCover}}" />
    <view class="profile-mask"></view>
    <view class="profile-avatar">
      <image wx:if="{{avatarUrl}}" mode="aspectFill" src="{{avatarUrl}}" binderror="onAvatarError" />
      <text wx:else>{{avatarInitial}}</text>
    </view>
  </view>

  <view class="profile-card card">
    <view class="between profile-name-row">
      <view class="nickname">
        <text>{{nickname}}</text>
        <app-icon name="check-circle" size="16" active />
      </view>
      <view class="edit-profile" bindtap="goEditProfile">编辑资料</view>
    </view>
    <view class="id-line">北京 · 滑雪</view>
    <view class="bio">{{bio}}</view>
    <view class="phone-status">
      <view class="phone-main">手机号：{{phoneText}}</view>
      <view class="phone-hint">{{phoneHint}}</view>
    </view>
    <view class="tag-row">
      <text class="tag">{{level}}</text>
      <text class="tag">单板</text>
      <text class="tag">喜欢刷道和公园</text>
    </view>

    <view class="stat-grid">
      <view class="stat" wx:for="{{stats}}" wx:key="label">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="info-card card">
    <view class="block-title">认证信息</view>
    <view class="tag-row">
      <view class="tag tag-soft tag-icon" wx:for="{{certifications}}" wx:key="*this">
        <app-icon name="check-circle" size="16" active />
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="info-card card">
    <view class="block-title">常去雪场</view>
    <view class="tag-row">
      <text class="tag tag-soft" wx:for="{{resorts}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="block-title second">滑行风格</view>
    <view class="tag-row">
      <text class="tag tag-soft" wx:for="{{styles}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="info-card card">
    <view class="between block-head">
      <view class="block-title">收到的评价（{{reviewCount}}）</view>
      <view class="more" bindtap="showAllReviews">
        <text>查看全部</text>
        <app-icon name="chevron-right" size="18" color="#7B8499" />
      </view>
    </view>
    <view wx:if="{{reviews.length}}">
      <view class="review" wx:for="{{reviews}}" wx:key="id">
        <view class="row">
          <view class="avatar">{{item.initial}}</view>
          <view class="review-main">
            <view class="review-name">
              <view class="review-user">
                <text>{{item.name}}</text>
                <app-icon name="check-circle" size="14" active />
              </view>
              <text>{{item.credit}}</text>
            </view>
            <view class="review-date">{{item.date}}</view>
          </view>
        </view>
        <view class="review-text">{{item.text}}</view>
        <view class="tag-row">
          <text class="tag tag-green" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
    <view class="empty-reviews" wx:else>
      <view class="empty-title">还没有收到评价</view>
      <view class="empty-sub">行程结束后，同行雪友给你的评价会显示在这里。</view>
    </view>
  </view>
  <view class="tabbar-spacer"></view>
</view>
