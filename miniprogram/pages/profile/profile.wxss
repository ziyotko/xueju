.profile-page {
  background: #f5f7fc;
}

.profile-hero {
  position: relative;
  height: 374rpx;
}

.profile-cover {
  width: 100%;
  height: 100%;
  border-radius: 0 0 30rpx 30rpx;
}

.profile-mask {
  position: absolute;
  inset: 0;
  border-radius: 0 0 30rpx 30rpx;
  background: linear-gradient(180deg, rgba(19, 29, 61, 0.06), rgba(245, 247, 252, 0.92));
}

.profile-avatar {
  position: absolute;
  left: 52rpx;
  bottom: -54rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 8rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #26314f, #5b6cff);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(44, 67, 126, 0.18);
  overflow: hidden;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.profile-card {
  margin: -6rpx 28rpx 22rpx;
  padding: 82rpx 28rpx 28rpx;
  border-radius: 24rpx;
}

.nickname {
  color: #151b2c;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.id-line {
  margin-top: 10rpx;
  color: #7b8499;
  font-size: 22rpx;
}

.bio {
  margin-top: 18rpx;
  color: #2f384e;
  font-size: 24rpx;
  line-height: 1.55;
}

.phone-status {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f7f9fd;
}

.phone-main {
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
}

.phone-hint {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
}

.tag-row {
  margin-top: 20rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f2f5fb;
}

.stat {
  text-align: center;
}

.stat-value {
  color: #151b2c;
  font-size: 34rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 6rpx;
  color: #7b8499;
  font-size: 20rpx;
}

.info-card {
  margin: 0 28rpx 22rpx;
  padding: 28rpx;
  border-radius: 24rpx;
}

.block-title {
  color: #151b2c;
  font-size: 28rpx;
  font-weight: 900;
}

.block-title.second {
  margin-top: 28rpx;
}

.more {
  color: #7b8499;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.review {
  margin-top: 22rpx;
}

.review-main {
  margin-left: 16rpx;
}

.review-name {
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.review-name text {
  color: #7b8499;
  font-weight: 500;
}

.review-user {
  color: #111827;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tag-icon {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.review-date {
  margin-top: 4rpx;
  color: #9aa3b7;
  font-size: 20rpx;
}

.review-text {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f7f9fd;
  color: #2f384e;
  font-size: 24rpx;
  line-height: 1.55;
}

.empty-reviews {
  margin-top: 22rpx;
  padding: 34rpx 24rpx;
  border-radius: 18rpx;
  background: #f7f9fd;
  text-align: center;
}

.empty-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 900;
}

.empty-sub {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

.profile-page.safe-bottom {
  padding-bottom: calc(92px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.profile-cover {
  background: #dce7f7;
}

.profile-name-row {
  align-items: flex-start;
}

.edit-profile {
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-actions {
  position: absolute;
  right: 28rpx;
  top: calc(24rpx + env(safe-area-inset-top));
  z-index: 5;
  display: flex;
  gap: 14rpx;
}

.profile-actions view {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}
