
.user-page{padding:24rpx 28rpx calc(130rpx + env(safe-area-inset-bottom));background:#f6f8fc;box-sizing:border-box}.user-card{padding:32rpx;margin-bottom:22rpx;text-align:center}.big{width:112rpx;height:112rpx;margin:0 auto 18rpx;font-size:42rpx}.name-row{display:flex;align-items:center;justify-content:center;gap:8rpx;color:#111827;font-size:34rpx;font-weight:900}.meta{margin-top:10rpx;color:#64748b;font-size:24rpx}.tags{margin-top:22rpx;display:flex;justify-content:center;flex-wrap:wrap;gap:12rpx}.tags text{height:44rpx;padding:0 16rpx;border-radius:999rpx;background:#eef2ff;color:#4f46e5;font-size:22rpx;display:flex;align-items:center}.section-title{color:#111827;font-size:30rpx;font-weight:900;text-align:left}.review{margin-top:18rpx;padding:20rpx;border-radius:18rpx;background:#f7f9fd;color:#334155;font-size:24rpx;line-height:1.5;text-align:left}.bottom-actions{position:fixed;left:28rpx;right:28rpx;bottom:calc(28rpx + env(safe-area-inset-bottom));display:flex;gap:18rpx}.bottom-actions button{height:80rpx;border:0;border-radius:24rpx;font-size:28rpx;font-weight:900;line-height:80rpx}.outline{width:180rpx;background:#fff;color:#64748b}.primary{flex:1;background:linear-gradient(135deg,#5965ff,#7b4cff);color:#fff}
