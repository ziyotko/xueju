<view class="home-page">
  <view
    class="home-page__navigation"
    style="height: {{navigationTotalHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <home-top-title
      title="发现行程"
      height="{{navigationContentHeight}}"
      side-inset="{{navigationSideInset}}"
    />
  </view>

  <view class="home-page__section home-page__section--search">
    <city-search-bar city="{{city}}" placeholder="搜索雪场 / 日期 / 关键词" bind:citytap="goCity" bind:searchtap="goSearch" bind:notifytap="goNotifications" />
  </view>

  <view class="home-page__section">
    <home-banner
      image="{{heroImage}}"
      title-lines="{{bannerTitleLines}}"
      subtitle="LET'S SKI TOGETHER"
      button-text="发布滑雪行程"
      bind:action="goCreate"
    />
  </view>
<!-- 
  <view class="home-page__section home-page__section--quick">
    <quick-entry-grid items="{{quickEntries}}" bind:entrytap="onQuickEntry" />
  </view> -->

  <view class="home-page__section home-page__section--tabs">
    <home-section-tabs tabs="{{tabs}}" active="{{activeTab}}" bind:change="onTabChange" bind:filter="openFilter" />
  </view>

  <view class="home-page__list">
    <ski-event-card
      wx:for="{{events}}"
      wx:key="id"
      event="{{item}}"
      bind:cardtap="goDetail"
      bind:jointap="goApply"
    />
  </view>
  <view class="tabbar-spacer"></view>
</view>
