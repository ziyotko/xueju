.home-page {
  min-height: 100vh;
  padding: 0 16px calc(92px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #f2f6ff 0%, #f6f8fc 34%, #f6f8fc 100%);
  overflow-x: hidden;
}

.home-page__navigation {
  margin: 0 -16px;
  box-sizing: border-box;
  flex-shrink: 0;
}

.home-page__section {
  margin-top: 0;
}

.home-page__section--search {
  margin-top: 4px;
  margin-bottom: 16px;
}

.home-page__section + .home-page__section {
  margin-top: 16px;
}

.home-page__section--quick {
  margin-top: 18px;
}

.home-page__section--tabs {
  margin-top: 20px;
}

.home-page__list {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
