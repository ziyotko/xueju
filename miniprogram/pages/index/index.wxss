.topbar {
  height: 68rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.city {
  font-size: 30rpx;
  font-weight: 800;
}

.search {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #9aa3b7;
  font-size: 24rpx;
}

.bell {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #151b2c;
}

.hero {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(21, 31, 72, 0.76), rgba(21, 31, 72, 0.2));
}

.hero-content {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 30rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.22;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 20rpx;
  letter-spacing: 0;
  opacity: 0.76;
}

.hero-button {
  margin: 24rpx 0 0;
  width: 190rpx;
  height: 58rpx;
  border: 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #5965ff, #885cff);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 58rpx;
}

.category-bar {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  margin-bottom: 30rpx;
}

.category {
  text-align: center;
}

.category-icon {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 10rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #5965ff;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(60, 77, 145, 0.08);
}

.category-text {
  color: #30384b;
  font-size: 20rpx;
}

.section-tabs {
  height: 56rpx;
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.tab {
  margin-right: 36rpx;
  color: #7b8499;
  font-size: 26rpx;
  font-weight: 700;
}

.tab.active {
  color: #151b2c;
}

.filter {
  margin-left: auto;
  color: #151b2c;
  font-size: 24rpx;
  font-weight: 700;
}

.event-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.event-main {
  display: flex;
  gap: 22rpx;
}

.event-info {
  flex: 1;
  min-width: 0;
}

.event-title {
  margin-top: 2rpx;
  color: #151b2c;
  font-size: 32rpx;
  font-weight: 900;
}

.event-date {
  margin-top: 12rpx;
  color: #2f384e;
  font-size: 24rpx;
}

.event-meta {
  margin-top: 8rpx;
  color: #7d879a;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag-row {
  margin-top: 14rpx;
}

.event-image {
  width: 170rpx;
  height: 170rpx;
  border-radius: 20rpx;
  background: #dbe5ff;
}

.event-footer {
  height: 56rpx;
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.avatars {
  display: flex;
  align-items: center;
}

.overlap {
  margin-left: -16rpx;
}

.people {
  margin-left: auto;
  color: #5962d9;
  font-size: 24rpx;
  font-weight: 700;
}

.host-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.host-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #25314f, #4fb7ff);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.host-name {
  color: #111827;
  font-size: 24rpx;
  font-weight: 800;
}

.host-credit {
  margin-top: 4rpx;
  color: #8790a3;
  font-size: 20rpx;
}

.join-button {
  width: 96rpx;
  height: 60rpx;
  border: 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #5965ff, #7b4cff);
  color: #ffffff;
  line-height: 60rpx;
  font-size: 24rpx;
  font-weight: 800;
}

