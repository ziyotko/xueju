.detail-page {
  min-height: 100vh;
  background: #f5f7fc;
  padding-bottom: 148rpx;
}

.cover {
  position: relative;
  height: 500rpx;
  overflow: hidden;
  border-radius: 0 0 34rpx 34rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(7, 12, 24, 0.12), rgba(7, 12, 24, 0.02) 45%, rgba(245, 247, 252, 0.18));
}

.cover-actions {
  position: absolute;
  top: 50rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.right-actions {
  display: flex;
  gap: 16rpx;
}

.round {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(21, 28, 43, 0.34);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  backdrop-filter: blur(8rpx);
}

.content-card {
  margin: 22rpx 28rpx 0;
  padding: 28rpx;
}

.detail-card {
  margin-top: -58rpx;
  position: relative;
  z-index: 2;
  border-radius: 26rpx;
}

.detail-title {
  font-size: 36rpx;
  line-height: 1.22;
  font-weight: 900;
  color: #151b2c;
}

.detail-sub {
  margin-top: 12rpx;
  color: #586276;
  font-size: 24rpx;
}

.tag-row {
  margin-top: 20rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: 154rpx 1fr;
  row-gap: 22rpx;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid #f1f4fa;
  font-size: 25rpx;
}

.info-label {
  color: #778197;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-value {
  color: #1f2937;
  font-weight: 650;
}

.block-title {
  margin-bottom: 22rpx;
  color: #151b2c;
  font-size: 30rpx;
  font-weight: 900;
}

.host-avatar {
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #25314f, #4fb7ff);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.host-name {
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.host-credit {
  margin-top: 6rpx;
  color: #8790a3;
  font-size: 22rpx;
}

.follow {
  width: 112rpx;
  height: 58rpx;
}

.member-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border-top: 2rpx solid #f5f7fb;
}

.member-row:first-of-type {
  border-top: 0;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #25314f, #4fb7ff);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.member-main {
  flex: 1;
  margin-left: 16rpx;
}

.member-name {
  font-size: 26rpx;
  font-weight: 800;
}

.role {
  color: #665cff;
  font-size: 20rpx;
}

.member-meta,
.member-credit {
  color: #7b8499;
  font-size: 22rpx;
}

.member-credit {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.empty-members {
  padding: 8rpx 0 4rpx;
  color: #8790a3;
  font-size: 24rpx;
}

.rule {
  margin-top: 18rpx;
  color: #3b4660;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 122rpx;
  padding: 18rpx 28rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  gap: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 36rpx rgba(55, 72, 128, 0.06);
}

.collect {
  width: 150rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 2rpx solid #edf0f7;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #30384b;
  font-size: 24rpx;
}

.apply {
  flex: 1;
}

.detail-page.safe-bottom {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.bottom-actions {
  bottom: env(safe-area-inset-bottom);
  height: 132rpx;
}

.manage {
  width: 150rpx;
  height: 76rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
}
.chat-action {
  width: 112rpx;
  height: 76rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
}


.apply.disabled {
  background: #cbd5e1;
  box-shadow: none;
}
