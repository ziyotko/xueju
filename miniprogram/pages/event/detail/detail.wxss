.detail-page {
  min-height: 100vh;
  background: #f5f7fc;
  padding-bottom: 148rpx;
}

.cover {
  position: relative;
  height: 500rpx;
  overflow: hidden;
  border-radius: 0 0 34rpx 34rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(7, 12, 24, 0.12), rgba(7, 12, 24, 0.02) 45%, rgba(245, 247, 252, 0.18));
}

.cover-actions {
  position: absolute;
  top: 50rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.right-actions {
  display: flex;
  gap: 16rpx;
}

.round {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(21, 28, 43, 0.34);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  backdrop-filter: blur(8rpx);
}

.icon-button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
}

.icon-button::after {
  border: 0;
}

.content-card {
  margin: 20rpx 24rpx 0;
  padding: 26rpx;
  border-radius: 18rpx;
  box-shadow: 0 10rpx 32rpx rgba(45, 61, 95, 0.06);
}

.detail-card {
  margin-top: -52rpx;
  position: relative;
  z-index: 2;
  border-radius: 18rpx;
}

.detail-title {
  font-size: 34rpx;
  line-height: 1.22;
  font-weight: 900;
  color: #151b2c;
}

.detail-sub {
  margin-top: 10rpx;
  color: #697386;
  font-size: 22rpx;
}

.tag-row {
  margin-top: 18rpx;
}

.detail-card .tag {
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.detail-card .tag-green {
  background: #e4f8ed;
  color: #1eb777;
}

.detail-card .tag-soft {
  background: #f2f5ff;
  color: #5362d6;
}

.info-grid {
  display: grid;
  grid-template-columns: 142rpx 1fr;
  margin-top: 18rpx;
  padding-top: 8rpx;
  font-size: 24rpx;
}

.info-label {
  min-height: 68rpx;
  color: #222b3f;
  display: flex;
  align-items: center;
  gap: 0;
  font-weight: 800;
}

.info-label app-icon {
  display: none;
}

.info-value {
  min-height: 68rpx;
  color: #1f2937;
  font-weight: 600;
  display: flex;
  align-items: center;
  line-height: 1.45;
}

.info-grid > view:nth-child(n+3) {
  border-top: 2rpx solid #f0f3f8;
}

.block-title {
  margin-bottom: 22rpx;
  color: #151b2c;
  font-size: 30rpx;
  font-weight: 900;
}

.host-avatar {
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #25314f, #4fb7ff);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  overflow: hidden;
  flex-shrink: 0;
}

.host-name {
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.host-credit {
  margin-top: 6rpx;
  color: #8790a3;
  font-size: 22rpx;
}

.follow {
  width: 112rpx;
  height: 58rpx;
}

.member-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border-top: 2rpx solid #f5f7fb;
}

.member-row:first-of-type {
  border-top: 0;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #25314f, #4fb7ff);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.member-main {
  flex: 1;
  margin-left: 16rpx;
}

.member-name {
  font-size: 26rpx;
  font-weight: 800;
}

.role {
  color: #665cff;
  font-size: 20rpx;
}

.member-meta,
.member-credit {
  color: #7b8499;
  font-size: 22rpx;
}

.member-credit {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.empty-members {
  padding: 8rpx 0 4rpx;
  color: #8790a3;
  font-size: 24rpx;
}

.rule {
  margin-top: 18rpx;
  color: #3b4660;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  padding: 16rpx 24rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #ffffff;
  box-shadow: 0 -10rpx 30rpx rgba(45, 61, 95, 0.08);
}

.bottom-actions button {
  margin: 0;
  padding: 0;
}

.bottom-actions button::after {
  border: 0;
}

.bottom-actions .collect {
  width: 132rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 2rpx solid #e8ebf2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #20293a;
  font-size: 23rpx;
  font-weight: 700;
}

.bottom-actions .button-primary.apply {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #5866ff 0%, #6e42ff 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(91, 91, 255, 0.24);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
  border: 0;
}

.detail-page.safe-bottom {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.bottom-actions {
  bottom: 0;
  height: calc(124rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-actions .button-outline.manage {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  border-color: #6e42ff;
  color: #6e42ff;
  font-size: 24rpx;
}
.bottom-actions .button-outline.chat-action {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  border-color: #6e42ff;
  color: #6e42ff;
  font-size: 24rpx;
}


.bottom-actions .button-primary.apply.disabled {
  background: #cbd5e1;
  box-shadow: none;
}
