<view class="detail-page safe-bottom">
  <view class="cover">
    <image class="cover-image" mode="aspectFill" src="{{event.image}}" />
    <view class="cover-mask"></view>
    <view class="cover-actions">
      <view class="round">‹</view>
      <view class="round">↗</view>
    </view>
  </view>

  <view class="content-card card">
    <view class="between">
      <view>
        <view class="detail-title">{{event.resort}}</view>
        <view class="detail-sub">{{event.date}} · {{event.depart}}</view>
      </view>
      <view class="tag tag-green">{{event.badge}}</view>
    </view>
    <view class="tag-row">
      <text class="tag">{{event.board}}{{event.level}}</text>
      <text class="tag tag-soft">刷道</text>
      <text class="tag tag-soft">可同行</text>
    </view>

    <view class="info-grid">
      <text>人数</text><text>共{{event.maxPeople}}人｜{{event.people}}</text>
      <text>集合时间</text><text>{{event.date}} {{event.time}}</text>
      <text>集合地点</text><text>朝阳大悦城停车场</text>
      <text>交通方式</text><text>{{event.traffic}}，费用 AA</text>
      <text>备注</text><text>{{event.note}}</text>
    </view>
  </view>

  <view class="content-card card">
    <view class="block-title">发起人</view>
    <view class="between">
      <view class="row">
        <view class="host-avatar">{{event.hostInitial}}</view>
        <view>
          <view class="host-name">{{event.host}} ✓</view>
          <view class="host-credit">{{event.credit}}　发起局数 12</view>
        </view>
      </view>
      <view class="button-outline follow">关注</view>
    </view>
  </view>

  <view class="content-card card">
    <view class="block-title">已加入成员（{{memberCount}}）</view>
    <view class="member-row" wx:for="{{members}}" wx:key="id">
      <view class="avatar">{{item.initial}}</view>
      <view class="member-main">
        <view class="member-name">{{item.name}} <text class="role">{{item.role}}</text></view>
        <view class="member-meta">{{item.level}}</view>
      </view>
      <view class="member-credit">{{item.credit}} ›</view>
    </view>
  </view>

  <view class="content-card card">
    <view class="block-title">局内规则</view>
    <view class="rule" wx:for="{{rules}}" wx:key="*this">✓ {{item}}</view>
  </view>

  <view class="bottom-actions">
    <view class="collect">☆ 收藏</view>
    <button class="button-primary apply" bindtap="goChat">申请加入</button>
  </view>
</view>
