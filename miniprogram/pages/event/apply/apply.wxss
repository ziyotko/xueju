.apply-page {
  padding: 24rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6f8fc;
}

.event-card {
  overflow: hidden;
}

.event-cover {
  width: 100%;
  height: 260rpx;
  background: #dce7f7;
}

.event-info {
  padding: 24rpx;
}

.event-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #111827;
}

.event-meta {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}

.form-card {
  margin-top: 22rpx;
  padding: 26rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.form-row {
  min-height: 86rpx;
  border-top: 2rpx solid #f1f4fa;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-row:first-of-type {
  border-top: 0;
}

.label {
  color: #334155;
  font-size: 26rpx;
  font-weight: 700;
}

.picker-value {
  display: flex;
  align-items: center;
  color: #64748b;
  font-size: 24rpx;
}

.field-input {
  text-align: right;
  color: #111827;
  font-size: 24rpx;
}

.save-phone-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0 4rpx;
  color: #64748b;
  font-size: 24rpx;
}

.message-box {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f7f9fd;
  box-sizing: border-box;
  color: #111827;
  font-size: 24rpx;
}

.tip {
  margin-top: 14rpx;
  color: #94a3b8;
  font-size: 22rpx;
}
