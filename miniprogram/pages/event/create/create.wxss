.create-page {
  background: #f6f8ff;
}

.form-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.block-title {
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #151b2c;
}

.form-row {
  height: 84rpx;
  display: flex;
  align-items: center;
  border-top: 2rpx solid #f3f5fb;
  color: #222b3f;
  font-size: 26rpx;
}

.form-row:first-of-type {
  border-top: 0;
}

.row-value {
  margin-left: auto;
  color: #a0a7b7;
}

.people-row {
  gap: 18rpx;
}

.stepper {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.stepper button {
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #f1f4ff;
  color: #4f5cff;
  line-height: 48rpx;
  font-size: 24rpx;
}

.people-hint {
  color: #9aa3b7;
  font-size: 22rpx;
}

.field-title {
  margin: 26rpx 0 16rpx;
  color: #3c455a;
  font-size: 24rpx;
  font-weight: 700;
}

.pill-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.pill-grid.wrap {
  grid-template-columns: repeat(4, 1fr);
}

.pill {
  height: 58rpx;
  border-radius: 20rpx;
  background: #f5f7fb;
  color: #596274;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pill.selected {
  background: #f0efff;
  color: #5f55ff;
  border: 2rpx solid #665cff;
}

.toggle-row {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #222b3f;
}

.note {
  width: 100%;
  min-height: 160rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f7f9fd;
  color: #222b3f;
  font-size: 24rpx;
}

.counter {
  margin-top: 8rpx;
  text-align: right;
  color: #a0a7b7;
  font-size: 20rpx;
}

.compliance-tip {
  padding: 0 8rpx 28rpx;
  color: #8c95aa;
  font-size: 22rpx;
}

.fixed-submit {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 34rpx;
}

