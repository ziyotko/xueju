
.report-page{padding:24rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));background:#f6f8fc;box-sizing:border-box}.report-card{padding:26rpx;margin-bottom:22rpx}.section-title{color:#111827;font-size:30rpx;font-weight:900;margin-bottom:18rpx}.reason{height:72rpx;border-top:2rpx solid #f1f4fa;display:flex;align-items:center;color:#334155;font-size:26rpx;font-weight:700}.reason:first-of-type{border-top:0}.reason.active{color:#4f46e5}.content{width:100%;min-height:200rpx;padding:20rpx;border-radius:18rpx;background:#f7f9fd;box-sizing:border-box;color:#111827;font-size:24rpx}.submit{height:84rpx;border:0;border-radius:24rpx;background:linear-gradient(135deg,#5965ff,#7b4cff);color:#fff;font-size:28rpx;font-weight:900;line-height:84rpx}
