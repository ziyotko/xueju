
.filter-page{
  padding:24rpx 28rpx calc(130rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  background:#f6f8fc;
}
.filter-card{padding:26rpx;margin-bottom:22rpx}.section-title{color:#111827;font-size:30rpx;font-weight:900;margin-bottom:18rpx}.tag-wrap{display:flex;flex-wrap:wrap;gap:14rpx}.switch-row{height:82rpx;border-top:2rpx solid #f1f4fa;display:flex;align-items:center;justify-content:space-between;color:#334155;font-size:26rpx;font-weight:700}.switch-row:first-of-type{border-top:0}.bottom-actions{position:fixed;left:28rpx;right:28rpx;bottom:calc(28rpx + env(safe-area-inset-bottom));display:flex;gap:18rpx}.confirm-action{flex:1}
