<view class="filter-page safe-bottom">
  <view class="filter-card card">
    <view class="section-title">日期与雪场</view>
    <picker mode="date" value="{{date}}" start="{{dateStart}}" bindchange="onDateChange">
      <view class="picker-row"><text>出发日期</text><text>{{date || '不限'}}</text></view>
    </picker>
    <picker mode="selector" range="{{resorts}}" value="{{resortIndex}}" bindchange="onResortChange">
      <view class="picker-row"><text>目的雪场</text><text>{{resorts[resortIndex]}}</text></view>
    </picker>
  </view>

  <view class="filter-card card">
    <view class="section-title">单双板</view>
    <view class="tag-wrap">
      <t-check-tag wx:for="{{skiTypes}}" wx:key="*this" checked="{{skiType === item}}" content="{{item}}" shape="round" size="large" data-value="{{item}}" bind:change="setSkiType" />
    </view>
    <view class="section-title secondary-title">交通方式</view>
    <view class="tag-wrap">
      <t-check-tag wx:for="{{trafficTypes}}" wx:key="*this" checked="{{trafficType === item}}" content="{{item}}" shape="round" size="large" data-value="{{item}}" bind:change="setTrafficType" />
    </view>
  </view>

  <view class="filter-card card">
    <view class="section-title">滑雪水平</view>
    <view class="tag-wrap">
      <t-check-tag
        wx:for="{{levels}}"
        wx:key="*this"
        checked="{{level === item}}"
        content="{{item}}"
        shape="round"
        size="large"
        data-value="{{item}}"
        bind:change="setLevel"
      />
    </view>
  </view>

  <view class="filter-card card">
    <view class="section-title">玩法需求</view>
    <view class="tag-wrap">
      <t-check-tag
        wx:for="{{tags}}"
        wx:key="*this"
        checked="{{selectedTagsMap[item]}}"
        content="{{item}}"
        shape="round"
        size="large"
        data-value="{{item}}"
        bind:change="toggleTag"
      />
    </view>
  </view>

  <view class="filter-card card">
    <view class="section-title">交通住宿</view>
    <view class="switch-row"><text>只看可拼车</text><t-switch value="{{carpool}}" data-key="carpool" bind:change="onSwitch" /></view>
    <view class="switch-row"><text>只看可拼房</text><t-switch value="{{roomShare}}" data-key="roomShare" bind:change="onSwitch" /></view>
    <view class="switch-row"><text>只看新手友好</text><t-switch value="{{beginner}}" data-key="beginner" bind:change="onSwitch" /></view>
    <view class="switch-row"><text>只看同性同行</text><t-switch value="{{sameGender}}" data-key="sameGender" bind:change="onSwitch" /></view>
  </view>

  <view class="bottom-actions">
    <t-button theme="default" variant="outline" shape="round" customStyle="width: 180rpx; height: 80rpx;" bind:tap="reset">重置</t-button>
    <view class="confirm-action">
      <t-button theme="primary" shape="round" block customStyle="height: 80rpx; box-shadow: 0 16rpx 32rpx rgba(79, 70, 229, 0.22);" bind:tap="confirm">确认筛选</t-button>
    </view>
  </view>
</view>
