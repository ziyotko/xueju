.search-page{min-height:100vh;padding:24rpx 28rpx 60rpx;box-sizing:border-box;background:#f6f8fc}.search-box{height:76rpx;padding:0 20rpx;display:flex;align-items:center;gap:14rpx}.search-box input{flex:1;height:76rpx;font-size:26rpx}.search-btn{height:52rpx;padding:0 18rpx;border-radius:999rpx;background:#eef2ff;color:#4f46e5;font-size:22rpx;font-weight:800;display:flex;align-items:center}.hot-card{margin-top:22rpx;padding:24rpx}.section-title{color:#111827;font-size:28rpx;font-weight:900}.hot-tags{margin-top:18rpx;display:flex;flex-wrap:wrap;gap:14rpx}.hot-tags view{height:54rpx;padding:0 20rpx;border-radius:999rpx;background:#f1f5f9;color:#334155;font-size:24rpx;display:flex;align-items:center}.result-count{margin:28rpx 0 16rpx;color:#64748b;font-size:24rpx}.result-list{display:flex;flex-direction:column;gap:18rpx}
