.trips-page {
  background: #f5f7fc;
}

.tabs {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.trip-tab {
  color: #7b8499;
  font-size: 25rpx;
  font-weight: 700;
  position: relative;
}

.trip-tab.active {
  color: #151b2c;
}

.trip-tab.active::after {
  content: "";
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: -16rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #665cff;
}

.group-title {
  margin: 28rpx 0 16rpx;
  color: #151b2c;
  font-size: 28rpx;
  font-weight: 900;
}

.trip-card {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
}

.trip-info {
  flex: 1;
  min-width: 0;
}

.trip-title {
  margin-top: 4rpx;
  color: #151b2c;
  font-size: 30rpx;
  font-weight: 900;
}

.trip-meta {
  margin-top: 10rpx;
  color: #596274;
  font-size: 23rpx;
}

.avatars {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.overlap {
  margin-left: -16rpx;
}

.joined {
  margin-left: 12rpx;
  color: #151b2c;
  font-size: 22rpx;
  font-weight: 700;
}

.trip-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(42, 63, 119, 0.12);
}

.trip-side {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  flex-shrink: 0;
}

.review-button {
  height: 52rpx;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.review-button::after {
  border: 0;
}

.history-card {
  padding: 26rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
}

.history-date {
  color: #7b8499;
  font-size: 22rpx;
}

.history-title {
  margin-top: 10rpx;
  color: #151b2c;
  font-size: 30rpx;
  font-weight: 900;
}

.history-meta {
  margin-top: 8rpx;
  color: #7b8499;
  font-size: 22rpx;
}

.floating-create {
  position: fixed;
  right: 32rpx;
  bottom: 130rpx;
  width: 232rpx;
  height: 76rpx;
  border: 0;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #5965ff, #7b4cff);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 18rpx 38rpx rgba(91, 101, 255, 0.28);
}

.trips-page.safe-bottom {
  padding-bottom: calc(96px + env(safe-area-inset-bottom));
}

.history-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-link {
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}


.empty-trips {
  padding: 44rpx 28rpx;
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

.empty-trips-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}
