<view class="chat-page">
  <view class="chat-header trip-summary-bar">
    <view class="chat-head-copy">
      <view class="chat-title">{{event.resort}}</view>
      <view class="chat-subtitle">{{readOnly ? (event.status === 'cancelled' ? '活动已取消 · 群聊历史只读' : '活动已结束 · 群聊历史只读') : ('已成局 · ' + event.date + ' ' + event.time + ' 出发')}}</view>
    </view>
  </view>

  <scroll-view
    class="chat-scroll"
    scroll-y
    scroll-into-view="{{toView}}"
    scroll-with-animation
    enhanced
    show-scrollbar="false"
    bindtap="hideActionPanel"
  >
	<view class="chat-notice">{{readOnly ? '该活动群聊已归档，仅可查看历史消息' : '你已加入群聊，行程信息以群内同步为准'}}</view>
	<view wx:if="{{nextBeforeId}}" class="chat-notice" bindtap="loadOlder">{{loadingOlder ? '加载中...' : '加载更早消息'}}</view>

    <view class="message-list">
	  <view id="msg-{{item.id}}" class="message-row {{item.side}}" wx:for="{{messages}}" wx:key="id" data-id="{{item.id}}" bindlongpress="reportMessage">
        <view wx:if="{{item.side === 'left'}}" class="avatar small">
          <image wx:if="{{item.avatarUrl}}" class="avatar-image" mode="aspectFill" src="{{item.avatarUrl}}" />
          <text wx:else>{{item.initial}}</text>
        </view>
        <view class="bubble {{item.system ? 'system' : ''}}">
          <view class="sender" wx:if="{{item.side === 'left'}}">{{item.displayName}}</view>
          <view class="content">{{item.content}}</view>
        </view>
        <view wx:if="{{item.side === 'right'}}" class="avatar small mine">
          <image wx:if="{{item.avatarUrl}}" class="avatar-image" mode="aspectFill" src="{{item.avatarUrl}}" />
          <text wx:else>我</text>
        </view>
        <text class="time">{{item.time}}</text>
      </view>
    </view>
    <view class="chat-bottom-spacer"></view>
  </scroll-view>

  <view wx:if="{{!readOnly}}" class="input-area {{actionPanelVisible ? 'panel-open' : ''}}">
    <!-- <view class="risk-tip">{{contentRiskMessage}}</view> -->
    <view class="input-bar">
      <input
        maxlength="1000"
        value="{{inputValue}}"
        bindinput="onInput"
        bindconfirm="onConfirm"
        confirm-type="send"
        placeholder="输入消息..."
        adjust-position="true"
        cursor-spacing="18"
      />
      <view class="tool-btn" bindtap="toggleActionPanel">
        <app-icon name="add-circle" size="24" color="#4F46E5" />
      </view>
      <button class="send-btn" bindtap="send">发送</button>
    </view>

    <view class="quick-panel" wx:if="{{actionPanelVisible}}">
      <view class="quick-item" wx:for="{{quickActions}}" wx:key="text" data-index="{{index}}" bindtap="sendQuickAction">
        <view class="quick-icon">
          <app-icon name="{{item.iconName}}" size="22" active />
        </view>
        <view>{{item.text}}</view>
      </view>
    </view>
  </view>
  <view wx:else class="readonly-bar">活动已结束或取消，群聊仅可查看历史消息</view>
</view>
