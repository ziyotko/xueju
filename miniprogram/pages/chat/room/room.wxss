.chat-page {
  height: 100vh;
  box-sizing: border-box;
  background: #f5f7fc;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-header {
  flex-shrink: 0;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f5f7fc;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-head-copy {
  flex: 1;
  min-width: 0;
}

.chat-title {
  color: #151b2c;
  font-size: 30rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-subtitle {
  margin-top: 6rpx;
  color: #7b8499;
  font-size: 22rpx;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx 0;
  box-sizing: border-box;
}

.chat-bottom-spacer {
  height: 28rpx;
}

.chat-notice {
  text-align: center;
  color: #a0a8b9;
  font-size: 21rpx;
  margin: 16rpx 0;
}

.message-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin: 26rpx 0;
}

.message-row.right {
  justify-content: flex-end;
}

.small {
  width: 54rpx;
  height: 54rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.mine {
  background: linear-gradient(135deg, #4f46e5, #7b4cff);
}

.bubble {
  max-width: 500rpx;
  margin: 0 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  background: #ffffff;
  color: #1f2937;
  font-size: 25rpx;
  line-height: 1.48;
  box-shadow: 0 12rpx 28rpx rgba(52, 73, 150, 0.06);
  word-break: break-all;
}

.message-row.right .bubble {
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  background: linear-gradient(135deg, #5965ff, #7b4cff);
  color: #ffffff;
}

.sender {
  margin-bottom: 8rpx;
  color: #7b8499;
  font-size: 20rpx;
}

.time {
  align-self: center;
  color: #b0b7c6;
  font-size: 20rpx;
}

.input-area {
  flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 2rpx solid #eef1f7;
  box-shadow: 0 -12rpx 36rpx rgba(55, 72, 128, 0.06);
}

.risk-tip {
  padding: 12rpx 28rpx 0;
  color: #9aa3b7;
  font-size: 20rpx;
}

.input-bar {
  height: 96rpx;
  padding: 12rpx 24rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #ffffff;
}

.input-bar input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #f7f9fd;
  font-size: 24rpx;
}

.tool-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #f7f9fd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #5965ff, #7b4cff);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 60rpx;
}

.send-btn::after { border: 0; }

.quick-panel {
  padding: 18rpx 24rpx 28rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 22rpx;
  background: #ffffff;
}

.quick-item {
  text-align: center;
  color: #596274;
  font-size: 22rpx;
}

.quick-icon {
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto 10rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #eef3ff, #f6f8ff);
  color: #4f6bff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}


.trip-summary-bar {
  border-bottom: 1rpx solid #edf1f7;
}
