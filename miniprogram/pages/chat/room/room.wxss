.chat-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 340rpx;
  box-sizing: border-box;
  background: #f6f8ff;
}

.chat-notice {
  text-align: center;
  color: #a0a7b7;
  font-size: 22rpx;
  margin: 16rpx 0;
}

.message-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin: 28rpx 0;
}

.message-row.right {
  justify-content: flex-end;
}

.small {
  width: 54rpx;
  height: 54rpx;
  font-size: 22rpx;
}

.bubble {
  max-width: 500rpx;
  margin: 0 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  background: #ffffff;
  color: #1f2937;
  font-size: 26rpx;
  line-height: 1.45;
  box-shadow: 0 12rpx 28rpx rgba(52, 73, 150, 0.06);
}

.message-row.right .bubble {
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  background: linear-gradient(135deg, #5965ff, #7b4cff);
  color: #ffffff;
}

.bubble.system {
  background: #ffffff;
}

.sender {
  margin-bottom: 8rpx;
  color: #7b8499;
  font-size: 20rpx;
}

.time {
  align-self: center;
  color: #b0b7c6;
  font-size: 20rpx;
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 190rpx;
  height: 92rpx;
  padding: 14rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border-top: 2rpx solid #eef1f7;
}

.input-bar input {
  flex: 1;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #f7f9fd;
  font-size: 24rpx;
}

.voice,
.emoji,
.input-bar button {
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  border-radius: 50%;
  border: 0;
  background: #ffffff;
  color: #151b2c;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 48rpx;
}

.risk-tip {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 164rpx;
  color: #9aa3b7;
  font-size: 20rpx;
}

.quick-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 24rpx 38rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 24rpx;
  background: #ffffff;
}

.quick-item {
  text-align: center;
  color: #596274;
  font-size: 22rpx;
}

.quick-icon {
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto 10rpx;
  border-radius: 16rpx;
  background: #eef3ff;
  color: #4f6bff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

