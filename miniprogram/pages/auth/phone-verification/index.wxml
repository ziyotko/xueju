<view class="verification-page safe-bottom">
  <view class="hero">
    <view class="hero-icon"><app-icon name="phone-locked" size="34" color="#FFFFFF" /></view>
    <view class="hero-title">手机号认证</view>
    <view class="hero-sub">{{statusLabel}}{{phoneMasked ? ' · ' + phoneMasked : ''}}</view>
  </view>

  <view class="card form-card">
    <view wx:if="{{status === 'verified' && !changeMode}}" class="verified-panel">
      <view class="verified-title">手机号已认证</view>
      <view class="verified-phone">{{phoneMasked}}</view>
      <view class="verified-tip">当前账号已具备发布、报名和群聊权限，无需再次获取验证码。</view>
      <button class="change-button" bindtap="startPhoneChange">更换手机号</button>
    </view>

    <block wx:else>
    <view class="purpose">为保障平台交流及活动安全，发布内容、发送消息、加入群聊及报名活动前，需要完成手机号认证。手机号仅用于账号实名认证、安全管理和依法配合调查，不会向其他用户公开。</view>

    <view class="field">
      <view class="label">手机号</view>
      <input type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入本人手机号" />
    </view>
    <view class="field code-field">
      <view class="code-main">
        <view class="label">短信验证码</view>
        <input type="number" maxlength="8" value="{{code}}" bindinput="onCodeInput" placeholder="请输入验证码" />
      </view>
      <button class="code-button" disabled="{{sending || countdown > 0}}" bindtap="sendCode">{{countdown > 0 ? countdown + '秒后重试' : (sending ? '发送中' : '获取验证码')}}</button>
    </view>

    <checkbox-group bindchange="onAgreementChange">
      <label class="agreement">
        <checkbox value="agreed" checked="{{agreed}}" color="#4F46E5" />
        <text>我已阅读并同意</text>
      </label>
    </checkbox-group>
    <view class="links"><text bindtap="showUserAgreement">《用户协议》</text><text bindtap="showPrivacy">《隐私政策》</text></view>

    <button class="submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{changeMode ? '验证新手机号并变更' : '提交认证'}}</button>
    <button wx:if="{{changeMode}}" class="cancel-change" bindtap="cancelPhoneChange">取消更换</button>
    </block>
  </view>

  <view class="security-note">完整手机号由服务端加密保存，其他用户和普通管理员只能看到脱敏号码。</view>
</view>
