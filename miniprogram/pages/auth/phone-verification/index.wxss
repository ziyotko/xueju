.verification-page{min-height:100vh;background:#f5f7fc;padding-bottom:48rpx;box-sizing:border-box}.hero{padding:52rpx 32rpx 70rpx;background:linear-gradient(135deg,#4f46e5,#6478ff);color:#fff;text-align:center}.hero-icon{width:88rpx;height:88rpx;margin:0 auto 20rpx;border-radius:28rpx;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center}.hero-title{font-size:40rpx;font-weight:900}.hero-sub{margin-top:12rpx;font-size:24rpx;opacity:.86}.form-card{margin:-36rpx 28rpx 0;padding:30rpx;border-radius:28rpx;position:relative}.purpose{padding:22rpx;border-radius:18rpx;background:#eef2ff;color:#475569;font-size:23rpx;line-height:1.65}.field{margin-top:28rpx;padding-bottom:18rpx;border-bottom:2rpx solid #edf0f6}.label{color:#111827;font-size:24rpx;font-weight:800}.field input{height:68rpx;font-size:28rpx;color:#111827}.code-field{display:flex;align-items:flex-end;gap:20rpx}.code-main{flex:1}.code-button{flex-shrink:0;margin:0 0 8rpx;padding:0 20rpx;height:60rpx;line-height:60rpx;border:0;border-radius:999rpx;background:#eef2ff;color:#4f46e5;font-size:22rpx}.code-button::after,.submit::after{border:0}.agreement{margin-top:28rpx;display:flex;align-items:center;gap:10rpx;color:#475569;font-size:22rpx}.agreement checkbox{transform:scale(.8)}.links{margin:12rpx 0 0 50rpx;display:flex;gap:12rpx;color:#4f46e5;font-size:22rpx}.submit{margin-top:32rpx;height:84rpx;line-height:84rpx;border-radius:999rpx;background:#4f46e5;color:#fff;font-size:28rpx;font-weight:900}.submit[disabled]{opacity:.65}.security-note{margin:24rpx 48rpx;color:#94a3b8;font-size:21rpx;line-height:1.6;text-align:center}
.verified-panel{text-align:center;padding:20rpx 8rpx}.verified-title{color:#111827;font-size:34rpx;font-weight:900}.verified-phone{margin-top:16rpx;color:#4f46e5;font-size:30rpx;font-weight:800}.verified-tip{margin-top:20rpx;color:#64748b;font-size:23rpx;line-height:1.65}.change-button{margin-top:34rpx;height:82rpx;line-height:82rpx;border:2rpx solid #dfe4ff;border-radius:999rpx;background:#f7f8ff;color:#4f46e5;font-size:27rpx;font-weight:800}.change-button::after,.cancel-change::after{border:0}.cancel-change{margin-top:14rpx;height:72rpx;line-height:72rpx;border:0;background:transparent;color:#64748b;font-size:24rpx}
