.notice-page{min-height:100vh;padding:24rpx 28rpx;background:#f6f8fc;box-sizing:border-box}.notice-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-bottom:20rpx}.notice-actions view{height:52rpx;padding:0 18rpx;border-radius:999rpx;background:#eef2ff;color:#4f46e5;font-size:22rpx;font-weight:800;display:flex;align-items:center}.notice-card{position:relative;padding:26rpx;margin-bottom:18rpx}.notice-card.is-read{opacity:.72}.dot{position:absolute;right:24rpx;top:24rpx;width:14rpx;height:14rpx;border-radius:50%;background:#ef4444}.notice-title{color:#111827;font-size:30rpx;font-weight:900}.notice-content{margin-top:10rpx;color:#334155;font-size:24rpx;line-height:1.5}.notice-time{margin-top:14rpx;color:#94a3b8;font-size:22rpx}.empty{padding:40rpx;text-align:center;color:#64748b;font-size:26rpx}
