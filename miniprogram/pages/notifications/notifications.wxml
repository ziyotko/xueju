<view class="notice-page">
  <view class="notice-actions"><view bindtap="markRead">全部已读</view><view bindtap="clearAll">清空通知</view></view>
  <view class="notice-card card {{item.read ? 'is-read' : ''}}" wx:for="{{notifications}}" wx:key="id">
    <view class="dot" wx:if="{{!item.read}}"></view>
    <view class="notice-title">{{item.title}}</view>
    <view class="notice-content">{{item.content}}</view>
    <view class="notice-time">{{item.time}}</view>
  </view>
  <view class="empty card" wx:if="{{!notifications.length}}">暂无通知</view>
</view>
