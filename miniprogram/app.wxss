page {
  min-height: 100vh;
  background: #f6f8fc;
  color: #182033;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  --td-brand-color: #5b6cff;
  --td-brand-color-active: #4f46e5;
  --td-brand-color-disabled: #c7d2fe;
  --td-brand-color-light: #eef2ff;
  --td-brand-color-light-active: #e0e7ff;
  --td-button-border-radius: 22rpx;
  --td-switch-checked-color: #5b6cff;
}

.page {
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.safe-bottom {
  /* 普通二级页面只预留 Home Indicator 安全区，避免出现大段空白滚动 */
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 46rpx rgba(55, 72, 128, 0.07);
}

.primary-gradient {
  background: linear-gradient(135deg, #4fb7ff 0%, #665cff 55%, #8d6dff 100%);
  color: #ffffff;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #7b8499;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  margin: 0 10rpx 10rpx 0;
  border-radius: 14rpx;
  background: #eef2ff;
  color: #5962d9;
  font-size: 21rpx;
  font-weight: 700;
}

.tag-green {
  background: #dff9ef;
  color: #20aa78;
}

.tag-soft {
  background: #f5f7fb;
  color: #60697d;
}

.avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1f2a44, #6a7dff);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  border: 4rpx solid #ffffff;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.button-primary {
  height: 78rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #5965ff, #7a4dff);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 36rpx rgba(92, 92, 255, 0.24);
  border: 0;
  padding: 0;
  line-height: 78rpx;
}

.button-outline {
  height: 68rpx;
  border-radius: 22rpx;
  border: 2rpx solid #665cff;
  color: #665cff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.safe-tab-page {
  /* Tab 页面才需要给自定义 tabBar 留空间；数值不要过大，否则短页面会空白滚动 */
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabbar-spacer {
  display: none;
  height: 0;
}

.button-clean::after,
button::after {
  border: 0;
}
