.home-banner {
  position: relative;
  height: 160px;
  overflow: hidden;
  border-radius: 18px;
  background: #dbeafe;
  box-shadow: 0 10px 26px rgba(35, 62, 116, 0.12);
}

.home-banner__image {
  width: 100%;
  height: 100%;
  display: block;
}

.home-banner__mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(15, 23, 42, 0.64) 0%, rgba(15, 23, 42, 0.28) 54%, rgba(15, 23, 42, 0.08) 100%);
}

.home-banner__shine {
  position: absolute;
  right: -44px;
  top: -48px;
  width: 160px;
  height: 160px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.2);
  filter: blur(20px);
}

.home-banner__content {
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 18px;
  color: #ffffff;
}

.home-banner__title {
  max-width: 288px;
  color: #ffffff;
  font-size: 22px;
  line-height: 1.22;
  font-weight: 800;
  letter-spacing: 0.2px;
  text-shadow: 0 2px 8px rgba(15, 23, 42, 0.28);
}

.home-banner__title-line {
  display: block;
  white-space: nowrap;
}

.home-banner__subtitle {
  margin-top: 8px;
  color: rgba(255, 255, 255, 0.88);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.4px;
}

.home-banner__button {
  width: 148px;
  min-width: 148px;
  height: 36px;
  margin-top: 14px;
  padding: 0 15px 0 16px;
  border-radius: 12px;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
  line-height: 36px;
  white-space: nowrap;
  box-shadow: 0 10px 22px rgba(79, 70, 229, 0.34);
}

.home-banner__button text {
  white-space: nowrap;
}
