.home-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-title-bar__title {
  flex: 1;
  text-align: center;
  color: #111827;
  font-size: 17px;
  font-weight: 600;
  line-height: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-title-bar__spacer {
  width: 48px;
  height: 44px;
  flex: 0 0 48px;
}
