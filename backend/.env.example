APP_NAME=xueju-api
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Shanghai

MYSQL_DSN=
JWT_SECRET=
JWT_EXPIRES_HOURS=168

WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Content moderation. aliyun performs text and image checks synchronously.
CONTENT_SECURITY_ENABLED=false
CONTENT_SECURITY_PROVIDER=aliyun
ALIYUN_CONTENT_SECURITY_ACCESS_KEY_ID=
ALIYUN_CONTENT_SECURITY_ACCESS_KEY_SECRET=
ALIYUN_CONTENT_SECURITY_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_TEXT_MODERATION_SERVICE=ugc_moderation_byllm_pro
ALIYUN_AVATAR_IMAGE_SERVICE=profilePhotoCheck
ALIYUN_EVENT_IMAGE_SERVICE=postImageCheck

# Legacy WeChat async image moderation settings (only used when provider=wechat).
WECHAT_CONTENT_SECURITY_ENABLED=false
WECHAT_MEDIA_CALLBACK_TOKEN=

# Production must use an HTTPS public origin. Uploaded file URLs are built
# from this value instead of trusting the inbound Host header.
PUBLIC_BASE_URL=
# Local storage is supported in single-node production only when UPLOAD_DIR is
# an absolute path (for example /soft/xueju/uploads). Back it up with the database.
UPLOAD_DIR=uploads
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Aliyun Phone Number Verification Service (SMS Authentication)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_VERIFY_SIGN_NAME=恒创联众
ALIYUN_SMS_VERIFY_TEMPLATE_CODE=100001
PHONE_ENCRYPTION_KEY=
PHONE_HASH_SECRET=
SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_DAILY_LIMIT_PER_USER=10
SMS_HOURLY_LIMIT_PER_IP=30
