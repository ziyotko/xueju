APP_NAME=xueju-api
APP_ENV=development
APP_PORT=8080

MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/xueju?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_HOURS=168

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CONTENT_SECURITY_ENABLED=false
WECHAT_MEDIA_CALLBACK_TOKEN=

# Production must use an HTTPS public origin. Uploaded file URLs are built
# from this value instead of trusting the inbound Host header.
PUBLIC_BASE_URL=
UPLOAD_DIR=uploads
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=xueju-admin
